      "memoryMB": 256
    },
    "group_course_payment_callback": {
      "timeoutSeconds": 60,
      "memoryMB": 256
    },
    "group_course_refund_callback": {
      "timeoutSeconds": 60,
      "memoryMB": 256
    },
    "group_course_maintenance": {
      "timeoutSeconds": 120,
      "memoryMB": 512
