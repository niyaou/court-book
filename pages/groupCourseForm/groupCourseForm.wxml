<view class="page">
  <view wx:if="{{error && !canManage}}" class="error">{{error}}</view>
  <view wx:if="{{needsAuth}}" class="card auth-card"><text class="small">请在个人中心登录管理员账号后创建课程。</text><button class="primary" bindtap="goToLogin" disabled="{{authorizing}}" loading="{{authorizing}}">前往个人中心</button></view>
  <view wx:if="{{loading}}" class="empty">正在加载基础资料…</view>
  <view wx:if="{{!loading && !needsAuth && !canManage}}" class="card empty">仅管理员可创建课程<view class="link" bindtap="retryContext">刷新权限</view></view>
  <block wx:if="{{canManage}}">
    <view wx:if="{{unresolved}}" class="notice">上次发布结果待核实。课程信息已固定，请使用下方按钮核实同一次发布，避免重复创建。</view>
    <view class="card"><view class="section-title">课程信息</view>
      <view class="field"><text class="field-label">教学内容模板</text><picker range="{{templates}}" range-key="title" bindchange="chooseTemplate" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{templateLabel}}<text>›</text></view></picker><view wx:if="{{!templates.length}}" class="field-hint">暂无启用的教学模板，请先在云数据库维护。</view></view>
      <view class="field"><text class="field-label">课程标题</text><input class="control" value="{{form.title}}" data-field="title" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" maxlength="100" placeholder="填写本次课程标题" /></view>
      <view class="field"><text class="field-label">教学详情</text><textarea class="control textarea" value="{{form.description}}" data-field="description" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" maxlength="5000" placeholder="教学目标、练习内容与适合人群" /></view>
      <view class="field"><text class="field-label">授课教练</text><picker range="{{coaches}}" range-key="name" bindchange="chooseCoach" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{coachLabel}}<text>›</text></view></picker></view>
    </view>
    <view class="card"><view class="section-title">场地与时间</view>
      <view class="field-grid"><view class="field"><text class="field-label">校区</text><picker range="{{campuses}}" range-key="name" bindchange="chooseCampus" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{form.campus || '选择校区'}}<text>›</text></view></picker></view><view class="field"><text class="field-label">场地</text><picker range="{{filteredCourts}}" range-key="label" bindchange="chooseCourt" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{courtLabel}}<text>›</text></view></picker></view></view>
      <view class="field"><text class="field-label">日期（北京时间）</text><picker mode="date" value="{{form.date}}" data-field="date" bindchange="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{form.date || '选择开课日期'}}<text>›</text></view></picker></view>
      <view class="field-grid"><view class="field"><text class="field-label">开始时间</text><picker mode="multiSelector" range="{{timeColumns}}" value="{{startTimePickerValue}}" data-field="startTime" bindchange="chooseTime" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{form.startTime || '选择开始时间'}}<text>›</text></view></picker></view><view class="field"><text class="field-label">结束时间</text><picker mode="multiSelector" range="{{timeColumns}}" value="{{endTimePickerValue}}" data-field="endTime" bindchange="chooseTime" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}"><view class="control">{{form.endTime || '选择结束时间'}}<text>›</text></view></picker></view></view><view class="field-hint">起止时间须为整点或半点，且在同一自然日内。</view>
    </view>
    <view class="card"><view class="section-title">价格与人数</view>
      <view class="field-grid"><view class="field"><text class="field-label">课程原价（元）</text><input class="control" type="number" value="{{form.priceYuan}}" data-field="priceYuan" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" placeholder="整数，至少1元" /></view><view class="field"><text class="field-label">优惠金额（元）</text><input class="control" type="number" value="{{form.vipPriceYuan}}" data-field="vipPriceYuan" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" placeholder="手动填写，不高于原价" /></view></view>
      <view class="field-grid"><view class="field"><text class="field-label">最低人数</text><input class="control" type="number" value="{{form.minParticipants}}" data-field="minParticipants" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" placeholder="填写成班人数" /></view><view class="field"><text class="field-label">人数上限</text><input class="control" type="number" value="{{form.maxParticipants}}" data-field="maxParticipants" bindinput="input" disabled="{{unresolved || submitting || showConfirm || publishedCourseId}}" placeholder="填写最多人数" /></view></view>
    </view>
    <view class="notice">确认后一次性发布。发布后不可修改，需要变更请整体取消后重新发布。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{publishedCourseId}}" class="primary" bindtap="openPublished">查看已发布课程</button><button wx:elif="{{unresolved}}" class="primary" bindtap="submitPending" loading="{{submitting}}" disabled="{{submitting}}">核实发布结果</button><button wx:else class="primary" bindtap="preparePublish" disabled="{{loading || submitting}}">发布</button>
  </block>
  <view wx:if="{{showConfirm}}" class="overlay" catchtouchmove="swallow"><view class="dialog"><view class="dialog-title">核对课程信息</view><scroll-view scroll-y class="summary-scroll"><view class="title">{{summary.title}}</view><view class="text-body summary-description">{{summary.description}}</view><view class="line">教练：{{summary.coach}}</view><view class="line">场地：{{summary.campus}} · {{summary.court}}</view><view class="line">时间：{{summary.time}}</view><view class="line">课时：{{summary.duration}} 分钟</view><view class="line">原价：¥{{summary.price}} · 优惠金额：¥{{summary.vipPrice}}</view><view class="line">人数：最低 {{summary.min}} 人 / 上限 {{summary.max}} 人</view><view class="line">报名截止：{{summary.deadline}}</view><view class="notice">{{summary.managed ? '确认后立即发布并占用场地。' : '确认后立即发布，仅记录团课场地安排，不占用订场系统。'}}发布后不可修改；需要变更请整体取消后重新发布。</view></scroll-view><view class="dialog-actions"><button class="secondary" bindtap="closeConfirm" disabled="{{submitting}}">返回修改</button><button class="primary" bindtap="confirmPublish" disabled="{{submitting}}" loading="{{submitting}}">确认发布</button></view></view></view>
</view>
