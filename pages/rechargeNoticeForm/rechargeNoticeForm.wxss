.container { min-height: 100vh; padding: 20rpx; box-sizing: border-box; background: #f5f5f5; }
.notice-tip, .edit-tip { margin-bottom: 20rpx; padding: 20rpx 22rpx; color: #5b21b6; background: #f3e8ff; border-radius: 10rpx; font-size: 24rpx; line-height: 1.55; }
.edit-tip { color: #92400e; background: #fef3c7; }
.form-card { margin-bottom: 20rpx; padding: 8rpx 24rpx 22rpx; background: #fff; border-radius: 10rpx; }
.field { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; border-bottom: 1rpx solid #eee; font-size: 28rpx; }
.field:last-child { border-bottom: 0; }
.label { color: #555; min-width: 145rpx; }
.static-value { color: #333; text-align: right; }
.section-title { padding: 18rpx 0; color: #333; font-size: 30rpx; font-weight: 600; }
.required { margin-left: 8rpx; color: #dc2626; font-size: 22rpx; font-weight: 400; }
.selected-member { display: flex; align-items: center; justify-content: space-between; padding: 18rpx; background: #f8fafc; border-radius: 8rpx; }
.member-name { color: #333; font-size: 28rpx; }
.member-number { margin-left: 14rpx; color: #94a3b8; font-size: 23rpx; }
.replace { color: #7c3aed; font-size: 25rpx; }
.inactive-tip { margin-top: 14rpx; padding: 12rpx; color: #9a3412; background: #fff7ed; border-radius: 6rpx; font-size: 23rpx; }
.search-box { border: 1rpx solid #ddd6fe; border-radius: 8rpx; overflow: hidden; }
.search-box input { padding: 18rpx; font-size: 27rpx; }
.search-loading, .search-result { padding: 16rpx 18rpx; border-top: 1rpx solid #eee; color: #555; font-size: 27rpx; }
.search-result { display: flex; justify-content: space-between; color: #7c3aed; }
textarea { width: 100%; min-height: 220rpx; box-sizing: border-box; padding: 18rpx; background: #f8fafc; border-radius: 8rpx; font-size: 27rpx; line-height: 1.5; }
.counter { margin-top: 10rpx; color: #94a3b8; text-align: right; font-size: 22rpx; }
.submit { margin: 32rpx 0; color: #fff; background: #7c3aed; border-radius: 10rpx; font-size: 30rpx; }
