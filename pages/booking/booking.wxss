/* 订场页显示层：原事件、数据与业务状态仍由 booking.js 提供。 */
page {
  background: #f4f8fb;
  color: #183247;
}

.booking-page-freeze {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #f8fbfd 0%, #f3f8fb 100%);
}

.booking-header-fixed {
  flex-shrink: 0;
  padding: 24rpx 28rpx 0;
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.campus-selector {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border: 1rpx solid #e7eff5;
  border-radius: 20rpx;
  background: #fff;
}

.campus-name {
  color: #1296db;
  font-size: 25rpx;
  font-weight: 600;
}

.campus-arrow {
  margin-left: 12rpx;
  color: #649bc9;
  font-size: 18rpx;
}

.venue-banner {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 166rpx;
  padding: 0;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(120deg, #1296db 0%, #2baed6 100%);
}

.venue-content {
  position: relative;
  z-index: 1;
}

.venue-name {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  pointer-events: none;
  max-width: 86%;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.venue-actions {
  display: flex;
  align-items: stretch;
}

/* 两个并列入口分别覆盖半张 Banner，标题和装饰不拦截点击。 */
.venue-left,
.venue-right {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 90rpx 28rpx 28rpx;
}

.venue-link {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  font-size: 25rpx;
  line-height: 1.4;
}

.venue-arrow {
  margin-left: 10rpx;
  font-size: 36rpx;
  line-height: 1;
}

.banner-arc,
.banner-accent {
  position: absolute;
  pointer-events: none;
  border-radius: 50%;
}

.banner-arc {
  right: -94rpx;
  bottom: -212rpx;
  width: 292rpx;
  height: 292rpx;
  border: 40rpx solid rgba(255, 255, 255, 0.15);
}

.banner-accent-yellow {
  top: -74rpx;
  right: -34rpx;
  width: 166rpx;
  height: 166rpx;
  background: linear-gradient(145deg, #fff078 0%, #f6e838 100%);
}

.banner-accent-apricot {
  right: -48rpx;
  bottom: -76rpx;
  width: 116rpx;
  height: 116rpx;
  background: linear-gradient(145deg, #ffd092 0%, #f1b16f 100%);
}

.date-scroll {
  padding: 18rpx 0 20rpx;
}

.date-scroll-view {
  width: 100%;
  height: 102rpx;
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 90rpx;
  height: 98rpx;
  margin-right: 10rpx;
  border: 1rpx solid #e8f0f5;
  border-radius: 18rpx;
  background: #fff;
  vertical-align: top;
}

.date-item:last-child {
  margin-right: 0;
}

.date-item .week {
  margin-bottom: 7rpx;
  color: #7d94a6;
  font-size: 23rpx;
}

.date-item .date {
  font-size: 25rpx;
  font-weight: 600;
}

.date-item.selected {
  color: #fff;
  border-color: #1296db;
  background: #1296db;
}

.date-item.selected .week {
  color: #fff;
}

.booking-schedule-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
  margin: 0 28rpx 20rpx;
  padding: 16rpx 20rpx 12rpx;
  overflow: hidden;
  border: 1rpx solid #e7eff5;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(27, 67, 91, 0.04);
}

.schedule-unit {
  flex-shrink: 0;
  margin-bottom: 10rpx;
  font-size: 21rpx;
  color: #8096a8;
  line-height: 1.3;
  text-align: right;
}

/* 单一滚动区域，表头和时间列在同一排期坐标系内冻结。 */
.booking-table-freeze {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}

.left-fixed-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: max-content;
  min-width: 100%;
}

.court-header {
  position: sticky;
  top: 0;
  z-index: 3;
  display: flex;
  flex-shrink: 0;
  align-items: stretch;
  min-width: 100%;
  height: 76rpx;
  background: #fff;
}

.corner-cell {
  position: sticky;
  left: 0;
  z-index: 4;
  flex: 0 0 88rpx;
  width: 88rpx;
  background: #fff;
}

.court-header-item {
  flex: 0 0 142rpx;
  box-sizing: border-box;
  width: 142rpx;
  padding: 0 10rpx 10rpx 0;
}

.court-header-label {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 100%;
  padding: 6rpx;
  border-radius: 14rpx;
  color: #29475c;
  background: #f0f7fb;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
  word-break: break-all;
}

.court-scroll-container {
  display: flex;
  align-items: flex-start;
  width: max-content;
  min-width: 100%;
}

.time-column {
  position: sticky;
  left: 0;
  z-index: 2;
  flex: 0 0 88rpx;
  width: 88rpx;
  background: #fff;
}

.time-item {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  height: 82rpx;
  padding-bottom: 10rpx;
  font-size: 24rpx;
  color: #526d82;
  line-height: 1.2;
}

.court-main {
  flex-shrink: 0;
}

.court-container {
  display: flex;
  align-items: flex-start;
}

.single-court {
  display: flex;
  flex: 0 0 142rpx;
  flex-direction: column;
  width: 142rpx;
}

/* 72rpx 色块 + 10rpx 留白，与时间列的 82rpx 行高一致。 */
.court-status-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  width: 132rpx;
  height: 72rpx;
  margin: 0 10rpx 10rpx 0;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  color: #183247;
  font-size: 25rpx;
}

.court-status-item.available {
  border-color: #e3edf4;
  background: #fff;
}

.court-status-item.booked {
  background: #b8dfca;
}

.court-status-item.vip-booked {
  background: #7cc5a0;
}

.court-status-item.self-booked,
.court-status-item.manager-self-booked {
  background: #b9aed8;
}

.court-status-item.locked {
  background: #e2c221;
}

.court-status-item.self-locked {
  background: #ffe066;
}

.court-status-item.other-locked {
  background: #c7c7c7;
}

.court-status-item.manager-locked {
  background: #d6dce1;
}

.court-status-item.selected {
  color: #fff;
  border-color: #1976d2;
  background: #1976d2;
}

/* 活动来源仅决定展示，避免被管理员/VIP 等占用样式覆盖。 */
.court-status-item.rush-booked {
  color: #55585c;
  border-color: transparent;
  background: #f2dc55;
}

.court-status-item.group-course-booked {
  color: #fff;
  border-color: transparent;
  background: #59aed7;
}

.slot-label {
  font-weight: 600;
}

.slot-selected {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.court-status-item.disabled {
  color: #999;
  background: #f5f5f5;
  opacity: 0.6;
}

.court-status-item.processing {
  opacity: 0.5;
  pointer-events: none;
}

/* 原合计、已选小时和按钮模块；权限与禁用条件保留在原模板中。 */
.booking-footer-fixed {
  position: sticky;
  bottom: 0;
  z-index: 20;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 100rpx;
  border-top: 1rpx solid #e7eff5;
  background: #fff;
}

.booking-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  gap: 10rpx;
  height: 100%;
  padding: 4px 24rpx;
}

.footer-left {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.price {
  margin-left: 6rpx;
  color: #1296db;
  font-size: inherit;
  font-weight: 700;
}

.footer-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10rpx;
}

.footer-btn {
  box-sizing: border-box;
  /* 覆盖 style:v2 的 wx-button:not([size=mini]) 默认 184px 宽度。 */
  width: 92px !important;
  flex-shrink: 0;
  min-height: 0;
  margin: 0 !important;
  padding: 10rpx 0;
  border: 1rpx solid transparent;
  border-radius: 28rpx;
  color: #a7b5bf;
  background: #edf2f5;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
}

.footer-btn::after {
  border: 0;
}

.footer-btn.active {
  color: #fff;
  background: #1296db;
}

.footer-btn.rush-btn.active {
  color: #1296db;
  border-color: #9ed6f2;
  background: #edf8ff;
}

.footer-btn[disabled],
.footer-btn.processing {
  color: #a7b5bf;
  border-color: transparent;
  background: #edf2f5;
}

/* 场馆分布弹窗样式 */
.venue-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.venue-modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80%;
  overflow: hidden;
}

.venue-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.venue-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.venue-modal-close {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.3s;
}

.venue-modal-close:hover {
  background-color: #f5f5f5;
}

.venue-modal-body {
  padding: 30rpx;
}

.venue-swiper {
  height: 400rpx;
}

.venue-image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

/* 校区选择弹窗样式 */
.campus-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.campus-modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 80%;
  max-width: 500rpx;
  max-height: 70%;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.campus-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.campus-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.campus-modal-close {
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.3s;
}

.campus-modal-close:hover {
  background-color: #f5f5f5;
}

.campus-modal-body {
  padding: 20rpx 0;
  max-height: 400rpx;
  overflow-y: auto;
}

.campus-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: background-color 0.3s;
}

.campus-item:last-child {
  border-bottom: none;
}

.campus-item:hover {
  background-color: #f8f9fa;
}

.campus-item.active {
  background-color: #e6f7ff;
  color: #007bff;
}

.campus-item-name {
  font-size: 30rpx;
  color: #333;
  flex: 1;
}

.campus-item.active .campus-item-name {
  color: #007bff;
  font-weight: 500;
}

.campus-item-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #007bff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.campus-item-check text {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

/* 支付提醒弹窗样式 */
.payment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.payment-modal-content {
  background: #fff;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  overflow: hidden;
}

.payment-modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.payment-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.payment-modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.payment-modal-main-text {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.6;
}

.payment-modal-special-note {
  margin-top: 20rpx;
}

.payment-modal-note-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.payment-modal-note-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 15rpx;
}

.payment-modal-note-item:last-child {
  margin-bottom: 0;
}

.payment-modal-footer {
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.payment-modal-btn {
  width: 100%;
  background: #007bff;
  color: #fff;
  border: none;
  border-radius: 10rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  line-height: 1;
}
